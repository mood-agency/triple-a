{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Triple A",
  "version": "0.1.0",
  "identifier": "com.triplea.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:11000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Triple A",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {}
}
