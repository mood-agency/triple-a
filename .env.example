# Supabase Configuration
# Get these values from your Supabase project dashboard: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Beeper Configuration (for WhatsApp integration)
VITE_BEEPER_API_URL=http://localhost:23373
VITE_BEEPER_TIMEOUT_MS=10000

# Sync Configuration
VITE_SYNC_INTERVAL_MS=300000
VITE_SYNC_DEBOUNCE_MS=2000

# Upload Limits
VITE_MAX_IMAGE_SIZE_MB=5
