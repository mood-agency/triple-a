{
  "name": "triple-a",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@triple-a/web",
    "dev:api": "turbo run dev --filter=@triple-a/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "dependency-cruiser": "^17.3.7",
    "husky": "^9.1.7",
    "turbo": "^2.3.0",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.5",
      "@tiptap/core": "^3.16.0",
      "@tiptap/pm": "^3.16.0"
    }
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
