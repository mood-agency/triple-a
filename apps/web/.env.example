# API Configuration
VITE_API_URL=https://your-api-service.railway.app

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Calendar Integration (optional)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Abbacchio Logging (optional - centralized log dashboard)
VITE_ABBACCHIO_ENABLED=true
VITE_ABBACCHIO_URL=http://localhost:4000/api/logs
VITE_ABBACCHIO_CHANNEL=triple-a-web
# VITE_ABBACCHIO_SECRET_KEY=your-encryption-key  # Optional: for E2E encryption