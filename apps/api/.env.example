# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Calendar Integration (optional)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI APIs (optional - for /api/summarize)
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# YouTube API (optional - for /api/youtube-*)
YOUTUBE_API_KEY=your-youtube-api-key

# Email Webhook (optional)
EMAIL_WEBHOOK_SECRET=your-webhook-secret

# Server Configuration
PORT=3000

# Abbacchio Logging (optional - centralized log dashboard)
ABBACCHIO_ENABLED=true
ABBACCHIO_URL=http://localhost:4001/api/logs
ABBACCHIO_CHANNEL=triple-a-api
# ABBACCHIO_SECRET_KEY=your-encryption-key  # Optional: for E2E encryption
