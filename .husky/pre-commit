# Validar código antes de hacer commit
echo "🔍 Validando código..."

# Validar API (bloqueante - debe pasar)
echo "\n📦 Validando API..."
pnpm --filter @triple-a/api lint
if [ $? -ne 0 ]; then
  echo "❌ Error: La validación del API falló."
  exit 1
fi

# Validar Web (bloqueante - debe pasar sin errores)
echo "\n🌐 Validando Web..."
pnpm --filter @triple-a/web lint
if [ $? -ne 0 ]; then
  echo "❌ Error: La validación de ESLint en Web falló."
  exit 1
fi

# Type checking Web (bloqueante - debe pasar)
echo "\n🔎 Type checking Web..."
pnpm --filter @triple-a/web type-check
if [ $? -ne 0 ]; then
  echo "❌ Error: Type check de Web falló."
  exit 1
fi

echo "\n✅ Todas las validaciones pasaron correctamente!"
