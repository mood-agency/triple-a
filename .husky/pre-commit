# Validar código antes de hacer commit
echo "🔍 Validando código..."

# Validar API (bloqueante - debe pasar)
echo "\n📦 Validando API..."
pnpm --filter @triple-a/api lint
if [ $? -ne 0 ]; then
  echo "❌ Error: La validación del API falló."
  exit 1
fi

# Validar Web (opcional - solo advertencia por ahora)
echo "\n🌐 Validando Web..."
pnpm --filter @triple-a/web lint || echo "⚠️  Advertencia: Hay warnings en Web (no bloquea commit)"

# Type checking Web
echo "\n🔎 Type checking Web..."
pnpm --filter @triple-a/web type-check || echo "⚠️  Advertencia: Hay errores de tipos en Web (no bloquea commit)"

echo "\n✅ Validación del API exitosa!"
